# Copy this file to ".env" (same folder) and fill in keys you have.
# .env is ignored by git, so your keys stay on your computer.
# Keys are only used to DOWNLOAD price data. Nothing in EdgeLab can place orders.

# OANDA (free practice/demo account -> Manage API Access). Planned forex downloader.
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# Twelve Data (free Basic plan). Optional alternative.
TWELVEDATA_API_KEY=

# Alpha Vantage (free key; 25 requests/day). Optional.
ALPHAVANTAGE_API_KEY=
