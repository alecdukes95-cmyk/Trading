# Copy this file to ".env" (same folder) and fill in the keys you have.
# .env is ignored by git, so your keys stay on your computer.
# EdgeLab only uses keys to READ data. It has no code that can place, change or cancel orders.

# OANDA: My Account -> Manage API Access -> generate a personal access token.
# Choose "practice" or "live" in EdgeLab: Settings -> Account -> Sync from OANDA.
OANDA_API_KEY=

# Optional alternatives
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
